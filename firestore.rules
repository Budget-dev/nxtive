rules_version = '2';

// ===============================================================
// NXTIVE Cloud Firestore Security Rules
// ===============================================================
// 1. Root Default-Deny: Disallow unauthorized reads/writes by default.
// 2. Products & Categories (Catalog):
//    - Public read: Any user (customer/visitor) can browse products and categories.
//    - Admin write (CRUD): Strictly restricted to primary administrator (nxtiveclothing@gmail.com).
// 3. Orders:
//    - Any customer can create an order.
//    - Customers can update payment transaction / UTR info on their own orders.
//    - Full read/update/delete restricted to admin and document owner.
// 4. Store Settings:
//    - Global settings readable by public storefront.
//    - Writes restricted to primary administrator.
// 5. Coupons & Reviews:
//    - Public read; admin manage.
// 6. Contact Inquiries:
//    - Public submit; admin manage.
// 7. Users:
//    - Document owner read/write; admin full access.
// 8. Logistics & Administrative Collections:
//    - Strictly primary administrator (nxtiveclothing@gmail.com).
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isPrimaryAdmin() {
      return isSignedIn() && (
        request.auth.uid == "jWYJT0xLXFRcojF6ZDwlWZaxJXv1" ||
        (request.auth.token.keys().hasAll(['email']) && (
          request.auth.token.email == "nxtiveclothing@gmail.com" ||
          request.auth.token.email.lower() == "nxtiveclothing@gmail.com"
        )) ||
        (request.auth.token.keys().hasAll(['admin']) && request.auth.token.admin == true)
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ─── 1. Products & Categories (Catalog) ──────────────────────
    match /products/{productId} {
      allow read: if true;
      allow write: if isPrimaryAdmin();

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isPrimaryAdmin();
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isPrimaryAdmin();

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isPrimaryAdmin();
      }
    }

    // ─── 2. Orders & Order Tracking ─────────────────────────────
    match /orders/{orderId} {
      // Allow any customer (signed-in or guest) to create an order
      allow create: if true;

      // Allow order read if admin or owner of the order or guest order
      allow read: if isPrimaryAdmin() || (
        isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          resource.data.uid == request.auth.uid
        )
      ) || (
        resource.data.userId == "guest" ||
        !('userId' in resource.data)
      );

      // Allow customer to update payment transaction / UTR info or admin to update anything
      allow update: if isPrimaryAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'upiTransactionId',
          'paymentTransactionId',
          'status',
          'paymentStatus',
          'statusHistory',
          'submittedAt',
          'updatedAt'
        ])
      );

      // Deletion is strictly admin-only
      allow delete: if isPrimaryAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isPrimaryAdmin();
      }
    }

    // ─── 3. Store Settings ──────────────────────────────────────
    match /settings/{settingId} {
      // Public storefront reads 'global' configuration (social gallery, banners)
      allow read: if settingId == 'global' || isPrimaryAdmin();
      allow write: if isPrimaryAdmin();

      match /{allSubcollections=**} {
        allow read: if settingId == 'global' || isPrimaryAdmin();
        allow write: if isPrimaryAdmin();
      }
    }

    // ─── 4. Promotional Coupons ─────────────────────────────────
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isPrimaryAdmin();

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isPrimaryAdmin();
      }
    }

    // ─── 5. Customer Reviews ────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isPrimaryAdmin();

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isPrimaryAdmin();
      }
    }

    // ─── 6. Contact Inquiries ───────────────────────────────────
    match /contactMessages/{messageId} {
      // Public contact form submission with basic field validation
      allow create: if request.resource.data.name is string &&
                       request.resource.data.email is string &&
                       request.resource.data.message is string;
      allow read, update, delete: if isPrimaryAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isPrimaryAdmin();
      }
    }

    // ─── 7. Users & Customer Profiles ───────────────────────────
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isPrimaryAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isPrimaryAdmin();
      }
    }

    // ─── 8. Shipping & Courier Logistics (Shiprocket Integration)
    match /shipping_providers/{providerId} {
      allow read: if true;
      allow write: if isPrimaryAdmin();

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isPrimaryAdmin();
      }
    }

    match /shipments/{shipmentId} {
      allow read, write: if isPrimaryAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isPrimaryAdmin();
      }
    }

    match /shipping_logs/{logId} {
      allow read, write: if isPrimaryAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isPrimaryAdmin();
      }
    }

    // ─── 9. Payments, Webhooks & Idempotency ────────────────────
    match /payments/{paymentId} {
      allow read, write: if isPrimaryAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isPrimaryAdmin();
      }
    }

    match /webhook_events/{eventId} {
      allow read, write: if isPrimaryAdmin();
    }

    match /order_idempotency/{id} {
      allow read, write: if isPrimaryAdmin();
    }

    // ─── 10. Admin Users, Roles & Audit Logs ─────────────────────
    match /admin_users/{adminId} {
      allow read, write: if isPrimaryAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isPrimaryAdmin();
      }
    }

    match /admin_roles/{roleId} {
      allow read, write: if isPrimaryAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isPrimaryAdmin();
      }
    }

    match /admin_logs/{logId} {
      allow read, write: if isPrimaryAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isPrimaryAdmin();
      }
    }

    // ─── DEFAULT ROOT FALLBACK (DENY ALL) ───────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
