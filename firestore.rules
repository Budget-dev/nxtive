rules_version = '2';

// ===============================================================
// NXTIVE Cloud Firestore Security Rules
// ===============================================================
// Architecture: Direct Client Key-Based Access
// Allows direct read and write access for all application collections
// using the Firebase Web API key without requiring custom auth claims
// or server-side OAuth tokens.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── 1. Products & Categories (Catalog) ──────────────────────
    match /products/{productId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /categories/{categoryId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ─── 2. Orders & Order Tracking ─────────────────────────────
    match /orders/{orderId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ─── 3. Store Settings ──────────────────────────────────────
    match /settings/{settingId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ─── 4. Promotional Coupons ─────────────────────────────────
    match /coupons/{couponId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ─── 5. Customer Reviews ────────────────────────────────────
    match /reviews/{reviewId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ─── 6. Contact Inquiries ───────────────────────────────────
    match /contactMessages/{messageId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ─── 7. Users & Customer Profiles ───────────────────────────
    match /users/{userId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ─── 8. Shipping & Courier Logistics ────────────────────────
    match /shipping_providers/{providerId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /shipments/{shipmentId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /shipping_logs/{logId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ─── 9. Payments & Webhooks ─────────────────────────────────
    match /payments/{paymentId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /webhook_events/{eventId} {
      allow read, write: if true;
    }

    match /order_idempotency/{id} {
      allow read, write: if true;
    }

    // ─── 10. Admin Users, Roles & Logs ──────────────────────────
    match /admin_users/{adminId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /admin_roles/{roleId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /admin_logs/{logId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ─── Default Fallback ───────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
