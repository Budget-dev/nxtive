rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // STRICT PRIMARY ADMIN: Only nxtiveclothing@gmail.com is authorized as an administrator.
    function isPrimaryAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && (request.auth.token.email == 'nxtiveclothing@gmail.com'
            || request.auth.token.email.matches('(?i)^nxtiveclothing@gmail\\.com$'));
    }

    function activeAdmin() {
      return isPrimaryAdmin();
    }

    function hasAdminPermission(permission) {
      return isPrimaryAdmin();
    }

    // ─── Public catalogue data ──────────────────────────────────
    // Product and category documents are public store data for browsing.
    // Allow read on products and categories for everyone.
    // Allow write to products and categories only if request.auth.token.email == 'nxtiveclothing@gmail.com'.
    match /products/{productId} {
      allow read: if true;
      allow write: if isPrimaryAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isPrimaryAdmin();
    }

    // Coupons contain promotion codes and discount rules. Only admin can view/manage.
    match /coupons/{couponId} {
      allow read, write: if isPrimaryAdmin();
    }

    // ─── Users & customers ──────────────────────────────────────
    // Allow a user to read/write their own users/{uid} document only if request.auth.uid == uid; allow the admin to read the full users collection.
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isPrimaryAdmin());
      allow write: if signedIn() && (request.auth.uid == userId || isPrimaryAdmin());
    }

    // ─── Reviews ─────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if (resource.data.status == 'approved') || isPrimaryAdmin();
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update, delete: if isPrimaryAdmin();
    }

    // ─── Orders ──────────────────────────────────────────────────
    match /orders/{orderId} {
      // 1. Anyone (including unauthenticated guest customers) can create a pending PhonePe order
      allow create: if (request.resource.data.keys().hasOnly([
          'customerName', 'customerPhone', 'amount', 'status',
          'paymentMethod', 'upiTransactionId', 'createdAt'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0)
        || (signedIn() && (request.resource.data.userId == request.auth.uid || isPrimaryAdmin()));

      // 2. Anyone with the order ID can submit the PhonePe transaction ID / UTR once while still pending
      allow update: if resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'upiTransactionId', 'status', 'submittedAt'
        ])
        && request.resource.data.status == 'submitted';

      // 3. Admins can read, verify, reject, or delete orders. Signed-in users can read their own orders.
      allow read: if (request.auth != null && (request.auth.token.admin == true || isPrimaryAdmin()))
                  || (signedIn() && resource.data.keys().hasAny(['userId']) && resource.data.userId == request.auth.uid);
      allow update: if (request.auth != null && (request.auth.token.admin == true || isPrimaryAdmin()));
      allow delete: if (request.auth != null && (request.auth.token.admin == true || isPrimaryAdmin()));
    }

    // ─── Shipping & logistics ───────────────────────────────────
    match /shipping_providers/{providerId} {
      allow read, write: if activeAdmin();
    }

    match /shipments/{shipmentId} {
      allow read: if activeAdmin()
                  || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if activeAdmin();
    }

    match /shipping_logs/{logId} {
      allow read, write: if activeAdmin();
    }

    // ─── Payments & audit logs ──────────────────────────────────
    match /payments/{paymentId} {
      allow read, write: if activeAdmin();
    }

    match /admin_logs/{logId} {
      allow read, create: if activeAdmin();
      allow update, delete: if false;
    }

    // ─── Admin users, roles, and settings ───────────────────────
    // Strictly locked to nxtiveclothing@gmail.com
    match /admin_users/{adminId} {
      allow read, write: if isPrimaryAdmin();
    }

    match /admin_roles/{roleId} {
      allow read, write: if isPrimaryAdmin();
    }

    match /settings/{settingId} {
      allow read, write: if isPrimaryAdmin();
    }

    // ─── Deny everything else by default ────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
