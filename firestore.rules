rules_version = '2';

// ===============================================================
// NXTIVE Cloud Firestore Security Rules
// ===============================================================
//
// Assumed Data Model:
//
// Collection: orders
// Document ID: orderId
// Fields:
//   - orderNumber: string (optional, max 128 chars) - human-readable order code
//   - userId: string (required, immutable, max 128 chars) - customer authentication UID
//   - customerEmail: string (optional, max 255 chars) - customer email address
//   - items: list of maps (required/optional, max 100 items) - purchased line items
//   - total: number (optional, >= 0, <= 10,000,000) - total payable order value
//   - totalAmount: number (optional, >= 0, <= 10,000,000) - alternate total amount
//   - amount: number (optional, >= 0, <= 10,000,000) - order payment value
//   - subtotal: number (optional, >= 0, <= 10,000,000) - merchandise subtotal
//   - discount: number (optional, >= 0, <= 10,000,000) - promotional discount applied
//   - shipping: number (optional, >= 0, <= 10,000,000) - courier shipping charges
//   - status: string (required/optional, max 50 chars) - order fulfillment lifecycle state
//   - statusHistory: list of maps (optional, max 100 entries) - order status progression logs
//   - paymentMethod: string (optional, max 100 chars) - payment method used (COD, Razorpay, etc.)
//   - paymentStatus: string (required/optional, max 50 chars) - payment settlement state
//   - paymentId: string (optional, max 255 chars) - payment gateway transaction ID
//   - razorpayOrderId: string (optional, max 255 chars) - Razorpay gateway order identifier
//   - razorpayPaymentId: string (optional, max 255 chars) - Razorpay gateway payment transaction identifier
//   - razorpaySignature: string (optional, max 255 chars) - Razorpay payment verification signature
//   - errorCode: string (optional, max 100 chars) - payment failure error code
//   - errorDescription: string (optional, max 1000 chars) - payment failure reason
//   - shippingAddress: map (optional) - shipping destination details
//   - deliveryMethod: string (optional, max 100 chars) - delivery carrier speed
//   - deliveryDateEstimate: string (optional, max 100 chars) - estimated transit time
//   - trackingNumber: string (optional, max 128 chars) - AWB or shipping tracking code
//   - trackingUrl: string (optional, max 2048 chars) - external tracking link
//   - idempotencyKey: string (optional, max 128 chars) - deduplication key
//   - notes: string (optional, max 1000 chars) - customer or admin order instructions
//   - cancelReason: string (optional, max 500 chars) - cancellation rationale
//   - returnReason: string (optional, max 500 chars) - return rationale
//   - createdAt: string or timestamp (optional/required) - order placement timestamp
//   - updatedAt: string or timestamp (optional) - last updated timestamp
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'nxtiveclothing@gmail.com' ||
        (request.auth.token.admin == true)
      );
    }

    function isOrderOwner() {
      return isAuthenticated() && (
        (('userId' in resource.data) && resource.data.userId == request.auth.uid) ||
        (('customerEmail' in resource.data) && resource.data.customerEmail == request.auth.token.email) ||
        isAdmin()
      );
    }

    // Domain validator enforcing type safety, field constraints, and DoS limits
    function isValidOrder(data) {
      return (!('userId' in data) || (data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128)) &&
             (!('orderNumber' in data) || (data.orderNumber is string && data.orderNumber.size() <= 128)) &&
             (!('customerEmail' in data) || (data.customerEmail is string && data.customerEmail.size() <= 255)) &&
             (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 255)) &&
             (!('customerPhone' in data) || (data.customerPhone is string && data.customerPhone.size() <= 50)) &&
             (!('total' in data) || (data.total is number && data.total >= 0 && data.total <= 10000000)) &&
             (!('totalAmount' in data) || (data.totalAmount is number && data.totalAmount >= 0 && data.totalAmount <= 10000000)) &&
             (!('amount' in data) || (data.amount is number && data.amount >= 0 && data.amount <= 10000000)) &&
             (!('subtotal' in data) || (data.subtotal is number && data.subtotal >= 0 && data.subtotal <= 10000000)) &&
             (!('discount' in data) || (data.discount is number && data.discount >= 0 && data.discount <= 10000000)) &&
             (!('shipping' in data) || (data.shipping is number && data.shipping >= 0 && data.shipping <= 10000000)) &&
             (!('items' in data) || (data.items is list && data.items.size() <= 100)) &&
             (!('statusHistory' in data) || (data.statusHistory is list && data.statusHistory.size() <= 100)) &&
             (!('shippingAddress' in data) || data.shippingAddress is map) &&
             (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 100)) &&
             (!('paymentStatus' in data) || (data.paymentStatus is string && data.paymentStatus.size() <= 50)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
             (!('paymentId' in data) || (data.paymentId is string && data.paymentId.size() <= 255)) &&
             (!('razorpayPaymentId' in data) || (data.razorpayPaymentId is string && data.razorpayPaymentId.size() <= 255)) &&
             (!('razorpayOrderId' in data) || (data.razorpayOrderId is string && data.razorpayOrderId.size() <= 255)) &&
             (!('razorpaySignature' in data) || (data.razorpaySignature is string && data.razorpaySignature.size() <= 255)) &&
             (!('errorCode' in data) || (data.errorCode is string && data.errorCode.size() <= 100)) &&
             (!('errorDescription' in data) || (data.errorDescription is string && data.errorDescription.size() <= 1000)) &&
             (!('idempotencyKey' in data) || (data.idempotencyKey is string && data.idempotencyKey.size() <= 128)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
             (!('cancelReason' in data) || (data.cancelReason is string && data.cancelReason.size() <= 500)) &&
             (!('returnReason' in data) || (data.returnReason is string && data.returnReason.size() <= 500)) &&
             (!('deliveryMethod' in data) || (data.deliveryMethod is string && data.deliveryMethod.size() <= 100)) &&
             (!('deliveryDateEstimate' in data) || (data.deliveryDateEstimate is string && data.deliveryDateEstimate.size() <= 100)) &&
             (!('trackingNumber' in data) || (data.trackingNumber is string && data.trackingNumber.size() <= 128)) &&
             (!('trackingUrl' in data) || (data.trackingUrl is string && data.trackingUrl.size() <= 2048));
    }

    // Rules for Client / Guest Order Creation
    function canClientCreateOrder() {
      return isValidOrder(request.resource.data) &&
             // Allowed initial status on client creation: 'created', 'pending', 'paid'
             (!('status' in request.resource.data) || request.resource.data.status in ['created', 'pending', 'paid']) &&
             // Allowed initial paymentStatus on client creation
             (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus in ['created', 'pending', 'paid']) &&
             // Tracking and logistics fields cannot be set by client
             (!('trackingNumber' in request.resource.data) || request.resource.data.trackingNumber == '' || request.resource.data.trackingNumber == null) &&
             (!('trackingUrl' in request.resource.data) || request.resource.data.trackingUrl == '' || request.resource.data.trackingUrl == null);
    }

    // Rules for Client / Guest Order Updates (Post-payment syncing, failure recording, cancellation)
    function canClientUpdateOrder() {
      return isValidOrder(request.resource.data) &&
             // Tracking and logistics fields cannot be set by client
             (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
               'trackingNumber',
               'trackingUrl',
               'deliveryDateEstimate'
             ])) &&
             // If status is updated, allowed transitions
             (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
              (request.resource.data.status in ['created', 'pending', 'paid', 'failed', 'cancelled']));
    }

    // ─── 1. Products & Categories (Catalog Management) ───────────
    match /products/{productId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /categories/{categoryId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ─── 2. Orders & Order Tracking ─────────────────────────────
    match /orders/{orderId} {
      // Order receipts, tracking, and customer confirmation
      allow read: if true;

      // Creation & Updates:
      // - Admins have full unconstrained management access.
      // - Clients can create orders with initial 'created'/'pending' state.
      // - Clients can update orders to record successful/failed payment outcomes or cancel,
      //   while price, cart items, order IDs, timestamps, and tracking fields are strictly locked.
      allow create: if (isAdmin() && isValidOrder(request.resource.data)) || canClientCreateOrder();
      allow update: if (isAdmin() && isValidOrder(request.resource.data)) || canClientUpdateOrder();
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read: if isOrderOwner();
        allow write: if isAdmin();
      }
    }

    // ─── 3. Store Settings & Social Gallery ──────────────────────
    match /settings/{settingId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ─── 4. Promotional Coupons ─────────────────────────────────
    match /coupons/{couponId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ─── 5. Customer Reviews ────────────────────────────────────
    match /reviews/{reviewId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ─── 6. Contact Inquiries ───────────────────────────────────
    match /contactMessages/{messageId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ─── 7. Users & Customer Profiles ───────────────────────────
    match /users/{userId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ─── 8. Shipping & Courier Logistics (Shiprocket) ───────────
    match /shipping_providers/{providerId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /shipments/{shipmentId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /shipping_logs/{logId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ─── 9. Payments, Webhooks & Idempotency ────────────────────
    match /payments/{paymentId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /webhook_events/{eventId} {
      allow read, write: if true;
    }

    match /order_idempotency/{id} {
      allow read, write: if true;
    }

    // ─── 10. Admin Management, Roles & Logs ──────────────────────
    match /admin_users/{adminId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /admin_roles/{roleId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /admin_logs/{logId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ─── DEFAULT ROOT FALLBACK (ALL OTHER COLLECTIONS) ───────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
