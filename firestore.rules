rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admin authorization is anchored to the server-managed admin_users
    // document.  User profile roles and arbitrary custom claims are not
    // sufficient to grant access.
    function activeAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.isActive == true
        && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role is string
        && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role != '';
    }

    function hasAdminPermission(permission) {
      return activeAdmin()
        && (
          get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'super_admin'
          || (
            get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.permissions is list
            && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.permissions.hasAny([permission])
          )
        );
    }

    // ─── Public catalogue data ──────────────────────────────────
    // Product and category documents are intentionally public store data.
    // Inactive products should never be published to clients.
    match /products/{productId} {
      allow read: if !resource.data.keys().hasAny(['isActive']) || resource.data.isActive == true;
      allow create: if hasAdminPermission('products.create');
      allow update: if hasAdminPermission('products.edit');
      allow delete: if hasAdminPermission('products.delete');
    }

    match /categories/{categoryId} {
      allow read: if !resource.data.keys().hasAny(['isActive']) || resource.data.isActive == true;
      allow create, update, delete: if hasAdminPermission('categories.edit');
    }

    // Coupons contain promotion codes and discount rules.  They are never a
    // public collection; checkout validates them through the server API.
    match /coupons/{couponId} {
      allow read: if hasAdminPermission('coupons.view');
      allow create, update, delete: if hasAdminPermission('coupons.manage');
    }

    // ─── Users & customers ──────────────────────────────────────
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || activeAdmin());
      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.role == 'customer'
                    && request.resource.data.isActive == true;
      // Customers may edit profile/contact fields, but cannot grant
      // themselves a role, activate a suspended account, or edit another
      // user's document.
      allow update: if activeAdmin()
                    || (signedIn()
                        && request.auth.uid == userId
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'displayName', 'photoURL', 'phone', 'addresses', 'updatedAt'
                        ])
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.isActive == resource.data.isActive);
      allow delete: if activeAdmin();
    }

    // ─── Reviews ─────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if (resource.data.status == 'approved') || hasAdminPermission('reviews.view');
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update: if hasAdminPermission('reviews.approve')
                    || hasAdminPermission('reviews.reject');
      allow delete: if hasAdminPermission('reviews.delete');
    }

    // ─── Orders ──────────────────────────────────────────────────
    // Order creation is server-only so catalogue prices, discounts, shipping,
    // identity, and idempotency are computed atomically by the API.
    match /orders/{orderId} {
      allow create: if false;
      allow read: if signedIn()
                  && (resource.data.userId == request.auth.uid || hasAdminPermission('orders.view'));
      allow update: if hasAdminPermission('orders.edit');
      allow delete: if hasAdminPermission('orders.edit');
    }

    // ─── Shipping & logistics ───────────────────────────────────
    // Provider configs can contain credentials and internal endpoints; they
    // are not public catalogue data.
    match /shipping_providers/{providerId} {
      allow read: if hasAdminPermission('shipping.view');
      allow create, update, delete: if hasAdminPermission('shipping.manage');
    }

    match /shipments/{shipmentId} {
      allow read: if hasAdminPermission('shipping.view')
                  || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if hasAdminPermission('shipping.manage');
    }

    match /shipping_logs/{logId} {
      allow read, write: if hasAdminPermission('shipping.manage');
    }

    // ─── Payments & audit logs ──────────────────────────────────
    match /payments/{paymentId} {
      allow read: if hasAdminPermission('payments.view');
      allow write: if hasAdminPermission('payments.manage');
    }

    match /admin_logs/{logId} {
      allow read: if hasAdminPermission('admins.view');
      allow create: if activeAdmin();
      allow update, delete: if false;
    }

    // ─── Admin users, roles, and settings ───────────────────────
    match /admin_users/{adminId} {
      // An authenticated user may read only their own record to bootstrap the
      // admin UI.  Admin management remains restricted to admins.manage.
      allow read: if signedIn()
                  && request.auth.token.email_verified == true
                  && request.auth.uid == adminId;
      allow create, update, delete: if hasAdminPermission('admins.manage');
    }

    match /admin_roles/{roleId} {
      allow read: if hasAdminPermission('admins.view');
      allow create, update, delete: if hasAdminPermission('admins.manage');
    }

    // Settings may contain notification and provider configuration.  Public
    // settings should be exposed through a deliberately scoped API instead of
    // making the entire settings collection readable.
    match /settings/{settingId} {
      allow read: if hasAdminPermission('settings.manage');
      allow write: if hasAdminPermission('settings.manage');
    }

    // ─── Deny everything else by default ────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
