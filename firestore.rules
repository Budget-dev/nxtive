rules_version = '2';

// ===============================================================
// NXTIVE Cloud Firestore Security Rules
// ===============================================================
// Assumed Data Models:
//
// 1. orders/{orderId}
//    - orderNumber: string (required/optional)
//    - customerName: string (<= 200 chars)
//    - customerPhone: string (<= 50 chars)
//    - customerEmail: string (<= 320 chars)
//    - uid / userId: string or null (user identity)
//    - amount, total, totalAmount: number (> 0)
//    - items: list (<= 100 items)
//    - shippingAddress: map (customer shipping details)
//    - status: string (e.g. 'pending', 'submitted', 'verified')
//    - statusHistory: list (<= 50 items)
//    - paymentMethod: string
//    - paymentStatus: string
//    - paymentTransactionId: string or null
//    - upiTransactionId: string or null
//    - deliveryMethod: string
//    - createdAt, updatedAt, submittedAt: timestamp / ISO string
//
// 2. users/{userId}
//    - Customer profile document owned by request.auth.uid == userId
//
// 3. products/{productId} & categories/{categoryId}
//    - Public catalogue browsing data; writable only by primary admin
//
// 4. contactMessages/{messageId}
//    - Inbound inquiries with required name, email, and message
//
// 5. settings/{settingId}
//    - 'global' readable by storefront visitors; all others admin-only
//
// 6. Logistics & Auditing
//    - shipping_providers, shipments, shipping_logs, payments,
//      admin_users, admin_roles, admin_logs
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Authentication & Authorization Helpers ─────────────────

    function signedIn() {
      return request.auth != null;
    }

    // Primary bootstrap administrator: strictly nxtiveclothing@gmail.com
    function isPrimaryAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && (request.auth.token.email == 'nxtiveclothing@gmail.com'
            || request.auth.token.email.matches('(?i)^nxtiveclothing@gmail\\.com$'));
    }

    // General administrator: primary admin email OR Firebase custom claims admin == true
    function isAdmin() {
      return isPrimaryAdmin()
        || (signedIn() && ('admin' in request.auth.token && request.auth.token.admin == true));
    }

    // Retained compatibility helper for administrative modules
    function activeAdmin() {
      return isAdmin();
    }

    function hasAdminPermission(permission) {
      return isAdmin();
    }

    // ─── Validation Helpers ─────────────────────────────────────

    function isValidOrderCreate(data) {
      return data.keys().hasOnly([
        'orderNumber', 'customerName', 'customerPhone', 'customerEmail',
        'uid', 'userId', 'amount', 'total', 'totalAmount',
        'items', 'shippingAddress', 'status', 'statusHistory',
        'paymentMethod', 'paymentStatus', 'paymentTransactionId',
        'upiTransactionId', 'deliveryMethod', 'createdAt', 'updatedAt'
      ])
      && (!('amount' in data) || (data.amount is number && data.amount > 0))
      && (!('total' in data) || (data.total is number && data.total >= 0))
      && (!('totalAmount' in data) || (data.totalAmount is number && data.totalAmount >= 0))
      && (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 200))
      && (!('customerPhone' in data) || (data.customerPhone is string && data.customerPhone.size() <= 50))
      && (!('customerEmail' in data) || (data.customerEmail is string && data.customerEmail.size() <= 320))
      && (!('status' in data) || (data.status is string && data.status.size() <= 50))
      && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 50))
      && (!('paymentStatus' in data) || (data.paymentStatus is string && data.paymentStatus.size() <= 50))
      && (!('deliveryMethod' in data) || (data.deliveryMethod is string && data.deliveryMethod.size() <= 100))
      && (!('items' in data) || (data.items is list && data.items.size() <= 100))
      && (!('shippingAddress' in data) || data.shippingAddress is map)
      && (!('statusHistory' in data) || (data.statusHistory is list && data.statusHistory.size() <= 50))
      && (!('upiTransactionId' in data) || data.upiTransactionId == null || (data.upiTransactionId is string && data.upiTransactionId.size() <= 100))
      && (!('paymentTransactionId' in data) || data.paymentTransactionId == null || (data.paymentTransactionId is string && data.paymentTransactionId.size() <= 100))
      && (!signedIn() || !('userId' in data) || data.userId == null || data.userId == request.auth.uid)
      && (!signedIn() || !('uid' in data) || data.uid == null || data.uid == request.auth.uid);
    }

    function isValidOrderUpdate() {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      return diff.hasOnly([
        'upiTransactionId',
        'paymentTransactionId',
        'status',
        'paymentStatus',
        'statusHistory',
        'submittedAt',
        'updatedAt'
      ])
      && (!diff.hasAny(['upiTransactionId']) || request.resource.data.upiTransactionId == null || (request.resource.data.upiTransactionId is string && request.resource.data.upiTransactionId.size() <= 100))
      && (!diff.hasAny(['paymentTransactionId']) || request.resource.data.paymentTransactionId == null || (request.resource.data.paymentTransactionId is string && request.resource.data.paymentTransactionId.size() <= 100))
      && (!diff.hasAny(['status']) || (request.resource.data.status is string && request.resource.data.status.size() <= 50))
      && (!diff.hasAny(['paymentStatus']) || (request.resource.data.paymentStatus is string && request.resource.data.paymentStatus.size() <= 50))
      && (!diff.hasAny(['statusHistory']) || (request.resource.data.statusHistory is list && request.resource.data.statusHistory.size() <= 50));
    }

    function isValidContactMessage() {
      let data = request.resource.data;
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.email is string && data.email.size() > 0 && data.email.size() <= 320
        && data.message is string && data.message.size() > 0 && data.message.size() <= 5000;
    }

    // ─── 1. Public Catalogue Data ────────────────────────────────
    // Browseable catalog is publicly readable; writeable only by primary admin.
    match /products/{productId} {
      allow read: if true;
      allow write: if isPrimaryAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isPrimaryAdmin();
    }

    // Promotional coupons
    match /coupons/{couponId} {
      allow read, write: if isPrimaryAdmin();
    }

    // ─── 2. Users & Customer Accounts ───────────────────────────
    // A signed-in user can read and write their own document; admins have full access.
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if signedIn() && (request.auth.uid == userId || isAdmin());
    }

    // ─── 3. Customer Reviews ────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if (resource.data.status == 'approved') || isAdmin();
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    // ─── 4. Orders ──────────────────────────────────────────────
    match /orders/{orderId} {
      // Create: customers (authenticated or guest) can create orders with validated schema
      allow create: if isValidOrderCreate(request.resource.data) || isAdmin();

      // Update: customers can update transaction identifiers, status, and history; admins can update any field
      allow update: if isValidOrderUpdate() || isAdmin();

      // Read: admins can read all orders; authenticated customers can only read their own orders
      allow read: if isAdmin()
                  || (signedIn() && (
                    ('userId' in resource.data && resource.data.userId == request.auth.uid)
                    || ('uid' in resource.data && resource.data.uid == request.auth.uid)
                  ));

      // Delete: administrators only
      allow delete: if isAdmin();
    }

    // ─── 5. Contact Inquiries ───────────────────────────────────
    match /contactMessages/{messageId} {
      // Create: anyone can send an inquiry via the storefront contact form with required fields
      allow create: if isValidContactMessage() || isAdmin();

      // Read, write, delete: administrator only
      allow read, update, delete: if isAdmin();
    }

    // ─── 6. Store Settings ──────────────────────────────────────
    match /settings/{settingId} {
      // Global settings (e.g. social feed, public config) readable by storefront; other docs primary admin
      allow read: if settingId == 'global' || isPrimaryAdmin();

      // Write: administrators only
      allow write: if isAdmin();
    }

    // ─── 7. Shipping & Logistics ────────────────────────────────
    match /shipping_providers/{providerId} {
      allow read, write: if activeAdmin();
    }

    match /shipments/{shipmentId} {
      allow read: if activeAdmin()
                  || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if activeAdmin();
    }

    match /shipping_logs/{logId} {
      allow read, write: if activeAdmin();
    }

    // ─── 8. Payments & Audit Logs ───────────────────────────────
    match /payments/{paymentId} {
      allow read, write: if activeAdmin();
    }

    match /admin_logs/{logId} {
      allow read, create: if activeAdmin();
      allow update, delete: if false;
    }

    // ─── 9. Administrative Users & Roles ────────────────────────
    // Strictly restricted to primary administrator (nxtiveclothing@gmail.com)
    match /admin_users/{adminId} {
      allow read, write: if isPrimaryAdmin();
    }

    match /admin_roles/{roleId} {
      allow read, write: if isPrimaryAdmin();
    }

    // ─── 10. Default Deny ───────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
