rules_version = '2';

// ===============================================================
// NXTIVE Cloud Firestore Security Rules (Direct Client Web Key Architecture)
// ===============================================================
// 1. Products & Categories (Catalog):
//    Full read/write allowed so admin dashboard can directly create, edit,
//    and manage products, categories, stock, and gallery photos from the browser.
// 2. Orders & Order Tracking:
//    Allow read and write for order placement, UTR payment verification,
//    and admin order fulfillment / status updates.
// 3. Store Settings & Social Gallery:
//    Allow read and write for storefront and admin settings management.
// 4. Coupons & Reviews:
//    Allow read and write for promotions and customer review workflows.
// 5. Contact Messages:
//    Allow submissions and admin inquiry management.
// 6. Users:
//    Allow profile management, sync, and user directory.
// 7. Logistics & Administration:
//    Shipping providers, shipments, logs, and roles accessible.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── 1. Products & Categories (Catalog) ──────────────────────
    match /products/{productId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /categories/{categoryId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ─── 2. Orders & Order Tracking ─────────────────────────────
    match /orders/{orderId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ─── 3. Store Settings ──────────────────────────────────────
    match /settings/{settingId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ─── 4. Promotional Coupons ─────────────────────────────────
    match /coupons/{couponId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ─── 5. Customer Reviews ────────────────────────────────────
    match /reviews/{reviewId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ─── 6. Contact Inquiries ───────────────────────────────────
    match /contactMessages/{messageId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ─── 7. Users & Customer Profiles ───────────────────────────
    match /users/{userId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ─── 8. Shipping & Courier Logistics (Shiprocket Integration)
    match /shipping_providers/{providerId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /shipments/{shipmentId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /shipping_logs/{logId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ─── 9. Payments, Webhooks & Idempotency ────────────────────
    match /payments/{paymentId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /webhook_events/{eventId} {
      allow read, write: if true;
    }

    match /order_idempotency/{id} {
      allow read, write: if true;
    }

    // ─── 10. Admin Users, Roles & Audit Logs ─────────────────────
    match /admin_users/{adminId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /admin_roles/{roleId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /admin_logs/{logId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ─── DEFAULT ROOT FALLBACK ───────────────────────────────────
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
