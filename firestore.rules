rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // STRICT PRIMARY ADMIN: Only venkateshchop14@gmail.com is authorized as an administrator.
    function isPrimaryAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email == 'venkateshchop14@gmail.com';
    }

    function activeAdmin() {
      return isPrimaryAdmin();
    }

    function hasAdminPermission(permission) {
      return isPrimaryAdmin();
    }

    // ─── Public catalogue data ──────────────────────────────────
    // Product and category documents are public store data for browsing.
    // Inactive products are hidden from public.
    // Only venkateshchop14@gmail.com can create, update, or delete products and categories.
    match /products/{productId} {
      allow read: if !resource.data.keys().hasAny(['isActive']) || resource.data.isActive == true || activeAdmin();
      allow create: if activeAdmin()
                    && request.resource.data.title is string
                    && request.resource.data.price is number
                    && request.resource.data.price >= 0;
      allow update: if activeAdmin();
      allow delete: if activeAdmin();
    }

    match /categories/{categoryId} {
      allow read: if !resource.data.keys().hasAny(['isActive']) || resource.data.isActive == true || activeAdmin();
      allow create, update, delete: if activeAdmin();
    }

    // Coupons contain promotion codes and discount rules. Only admin can view/manage.
    match /coupons/{couponId} {
      allow read, create, update, delete: if activeAdmin();
    }

    // ─── Users & customers ──────────────────────────────────────
    match /users/{userId} {
      // User can read their own profile; only primary admin (venkateshchop14@gmail.com) can inspect any user profile
      allow read: if signedIn() && (request.auth.uid == userId || activeAdmin());
      // Users can register/create their customer profile
      allow create: if signedIn()
                    && (request.auth.uid == userId || activeAdmin())
                    && (activeAdmin() || request.resource.data.role == 'customer');
      // Customers may edit their personal contact fields, but cannot grant
      // themselves an admin role or edit another user's document.
      allow update: if activeAdmin()
                    || (signedIn()
                        && request.auth.uid == userId
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'displayName', 'name', 'photoURL', 'avatarUrl', 'phone', 'city', 'state', 'addresses', 'updatedAt'
                        ])
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.isActive == resource.data.isActive);
      allow delete: if activeAdmin();
    }

    // ─── Reviews ─────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if (resource.data.status == 'approved') || activeAdmin();
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update, delete: if activeAdmin();
    }

    // ─── Orders ──────────────────────────────────────────────────
    // Order creation is processed via server API. Customers can read their own orders.
    // Only primary admin can inspect all orders or update order status / shipping details.
    match /orders/{orderId} {
      allow create: if activeAdmin();
      allow read: if signedIn()
                  && (resource.data.userId == request.auth.uid || activeAdmin());
      allow update, delete: if activeAdmin();
    }

    // ─── Shipping & logistics ───────────────────────────────────
    match /shipping_providers/{providerId} {
      allow read, write: if activeAdmin();
    }

    match /shipments/{shipmentId} {
      allow read: if activeAdmin()
                  || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if activeAdmin();
    }

    match /shipping_logs/{logId} {
      allow read, write: if activeAdmin();
    }

    // ─── Payments & audit logs ──────────────────────────────────
    match /payments/{paymentId} {
      allow read, write: if activeAdmin();
    }

    match /admin_logs/{logId} {
      allow read, create: if activeAdmin();
      allow update, delete: if false;
    }

    // ─── Admin users, roles, and settings ───────────────────────
    // Strictly locked to venkateshchop14@gmail.com
    match /admin_users/{adminId} {
      allow read, write: if isPrimaryAdmin();
    }

    match /admin_roles/{roleId} {
      allow read, write: if isPrimaryAdmin();
    }

    match /settings/{settingId} {
      allow read, write: if isPrimaryAdmin();
    }

    // ─── Deny everything else by default ────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
